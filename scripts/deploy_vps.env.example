# Personal deploy target — copy this to `deploy_vps.env` (gitignored) and fill in your host.
# The framework never hardcodes a VPS; without this, deploy_vps.sh refuses to run.
#
#   cp scripts/deploy_vps.env.example scripts/deploy_vps.env
#   # edit deploy_vps.env to set MUSHEGH_VPS=openclaw@<your-host>
#
# Then:
#   bash scripts/deploy_vps.sh

# MUSHEGH_VPS=user@<your-server-host>     # the brain's 24/7 host (ssh-target)
# MUSHEGH_VPS_DIR=/home/<user>/mushegh     # optional override for the remote install dir