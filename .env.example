# Mushegh configuration — copy to `.env` and fill in. All keys are prefixed MUSHEGH_.
# Never commit the real .env (see .gitignore).

# ---- Identity: make this YOUR assistant (no code/persona edits needed) ----------------
# The persona file is a template; these fill it in. Defaults are generic; personalise here.
MUSHEGH_ASSISTANT_NAME=Mushegh                 # what your assistant calls itself
MUSHEGH_USER_NAME=                            # your name (blank = it won't use a name)
MUSHEGH_USER_ADDRESS=                         # how it addresses you: "sir", "boss", your name, or blank
# Supported: English, Russian, German, French, Spanish, Ukrainian (names, endonyms or codes).
MUSHEGH_UNDERSTOOD_LANGUAGES=English          # comma-list it can UNDERSTAND (STT)
# A language name pins the reply; "match" answers in whichever of the above was just spoken.
# Mirror mode needs a multilingual TTS model (eleven_flash_v2_5 / eleven_multilingual_v2) and an
# STT that hears them all -- Deepgram's 'multi' covers all but Ukrainian; whisper covers all six.
MUSHEGH_REPLY_LANGUAGE=English                # a language name, or "match"
MUSHEGH_USER_TZ=UTC                           # your IANA timezone, e.g. Europe/Berlin, America/New_York
MUSHEGH_PERSONA_FILE=mushegh.md                # which file in personality/ holds the persona template

# ---- Provider selection ---------------------------------------------------------------
# Cloud-first for quality; if a cloud provider can't be built it AUTO-FALLS-BACK to the local
# engine (voice_local_fallback). Set MUSHEGH_STT_PROVIDER=whisper if you speak Armenian/Ukrainian.
MUSHEGH_STT_PROVIDER=deepgram          # deepgram (cloud, accurate) | whisper | moonshine (local)
MUSHEGH_TTS_PROVIDER=elevenlabs        # elevenlabs (the voice) | piper | kokoro (local, offline)
MUSHEGH_VOICE_LOCAL_FALLBACK=true      # cloud fails -> use local engine (so the pipeline always comes up)
MUSHEGH_TTS_FALLBACK_PROVIDER=piper    # local TTS used if the cloud TTS can't be built
MUSHEGH_STT_FALLBACK_PROVIDER=whisper  # local STT used if the cloud STT can't be built
MUSHEGH_LLM_BACKEND=freellmapi         # Mushegh's OWN brain: freellmapi | ollama | openai

# Optional typed decision layer. Jev selects among explicit owner-supplied options; the LLM only
# verbalizes that result. It never bypasses deterministic safety, confirmation, privacy or budgets.
TYPESAFE_API_KEY=
MUSHEGH_JEV_ENABLED=true
MUSHEGH_JEV_MODEL=jev-latest
MUSHEGH_JEV_TIMEOUT_SECONDS=8
MUSHEGH_OPENCLAW_DELEGATION_ENABLED=true   # let Mushegh CONSULT the OpenClaw fleet as a tool

# ---- ElevenLabs: the voice you want Mushegh to have ------------------------------------
MUSHEGH_ELEVENLABS_API_KEY=
MUSHEGH_ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency for streaming; eleven_turbo_v2_5 = a bit higher quality
MUSHEGH_ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Deepgram: accurate streaming speech recognition ("understands me really well") ---
MUSHEGH_DEEPGRAM_API_KEY=
MUSHEGH_DEEPGRAM_MODEL=nova-3
# Multilingual understanding. Mushegh ALWAYS replies in English; this only sets which spoken
# languages he can understand. 'multi' = Deepgram nova-3 code-switch across English/French/
# German/Russian (low latency). Deepgram does NOT support Armenian, and Ukrainian isn't in 'multi'
# — to understand ALL SIX (incl. Armenian + Ukrainian) set MUSHEGH_STT_PROVIDER=whisper (local
# faster-whisper, auto-detect; heavier on a no-GPU CPU but covers everything).
MUSHEGH_DEEPGRAM_LANGUAGE=multi

# ---- Audio routing (speakers <-> headphones / AirPods) --------------------------------
# Where Mushegh plays his voice. Alias ("speakers" | "headphones" | "airpods"), a device-name
# fragment, or a numeric index. Blank = OS default. A voice command ("switch to my headphones")
# saves a preference that overrides this at next start. Input stays on the laptop mic so
# Bluetooth keeps high-quality A2DP output (using AirPods as the mic forces low-quality HFP).
MUSHEGH_AUDIO_OUTPUT_DEVICE=
# Pin the mic by NAME substring (survives Bluetooth index shuffles), or by index.
MUSHEGH_AUDIO_INPUT_DEVICE_NAME=
# Left commented rather than blank ON PURPOSE. This field is `int | None = None`, and
# `env_ignore_empty` is False, so a blank here is read as the empty STRING and raises
# ValidationError - a fresh machine cannot start. Commented = absent = the None default.
# MUSHEGH_AUDIO_INPUT_DEVICE_INDEX=

# ---- Smart barge-in (interrupt Mushegh mid-sentence by speaking) -----------------------
# 'auto' detects your live output device and turns barge-in ON only on a PRIVATE endpoint
# (headphones / AirPods / smart-glasses / phone-with-earbuds) and OFF on open speakers, so
# Mushegh never interrupts himself. 'on'/'off' force it.
MUSHEGH_BARGE_IN_MODE=auto
# Remote clients (Mentra glasses, iPhone, Android) declare how you're listening since the local
# device name can't tell: glasses | phone-headphones | android-headphones | phone-speaker |
# android | headphones | speakers. Blank on a local host (Windows/macOS/Linux laptop).
MUSHEGH_DEVICE_HINT=

# ---- Wake words -----------------------------------------------------------------------
# The engine is NOT selectable. openWakeWord is the only one, and it runs on-device (D-19).
# `MUSHEGH_WAKE_WORD_ENGINE` and `MUSHEGH_PORCUPINE_ACCESS_KEY` were removed 2026-10-04: they were
# still listed here long after `src/mushegh/config.py` stopped reading them, so setting either
# did precisely nothing while looking like a real switch.
MUSHEGH_WAKE_WORD_ENABLED=true
MUSHEGH_WAKE_WORDS=mushegh,alfred,robbin,assist,time to work,wake up,six-one-nine
MUSHEGH_WAKE_WORD_THRESHOLD=0.5

# ---- Brain / OpenClaw fleet -----------------------------------------------------------
# The brain WebSocket server (`python -m mushegh.brain.server`) hosts ONE shared MusheghAgent so the
# laptop, iPhone (clients/iphone/) and Mentra glasses all reach the SAME brain + memory.
MUSHEGH_BRAIN_HOST=127.0.0.1            # set 0.0.0.0 to reach it from the phone/glasses (same Wi-Fi)
MUSHEGH_BRAIN_PORT=8765                 # WebSocket /voice port
MUSHEGH_CLIENT_HTTP_PORT=8766           # serves the iPhone web client at http://<host>:8766/iphone/
MUSHEGH_API_AUTH_TOKEN=                 # blank = loopback only; set a bearer secret when on 0.0.0.0
MUSHEGH_BRAIN_WS_URL=ws://127.0.0.1:8765/voice
MUSHEGH_OPENCLAW_GATEWAY_URL=http://127.0.0.1:8800
MUSHEGH_OPENCLAW_ROUTER_AGENT=ispir

# ---- freellmapi (direct-answer LLM) ---------------------------------------------------
MUSHEGH_FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
MUSHEGH_FREELLMAPI_API_KEY=

# ---- LLM latency tuning (see docs/AUDIT.md) -------------------------------------------
# A chain entry prefixed "groq:" hits Groq DIRECTLY (fast, consistent TTFT ~0.3s) using the key
# below — the best primary for a snappy voice turn. e.g. MUSHEGH_LLM_PRIMARY_MODEL=groq:llama-3.3-70b-versatile
MUSHEGH_GROQ_API_KEY=                     # https://console.groq.com -> API Keys (free tier available)
# If no FIRST token arrives within this many seconds, cancel + fail over to the next model.
MUSHEGH_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=4.0
# Optional two-tier: a fast model tried FIRST (then the normal chain as quality fallback). Blank = off.
MUSHEGH_LLM_FAST_MODEL=                    # e.g. llama-3.1-8b-instant  (or groq:llama-3.1-8b-instant)
# D-92: a CHEAP, DEDICATED tier for the Jev verdict verbalizer ONLY. The verbalizer restates a
# decision Jev already made and its reply is prefix-validated, so a small model degrades wording,
# never the choice. Blank = off (the normal chain is used, exactly as before).
# Unlike MUSHEGH_LLM_FAST_MODEL this does NOT touch the main turn.
# The binding requirement is language coverage: ru, uk, de, fr.
MUSHEGH_VERBALIZER_MODELS=                 # e.g. ollama:qwen3:0.6b,groq:llama-3.1-8b-instant

# ======================================================================================
# Phase 3 — knowledge & channel tools. Each is OPTIONAL: leave a block blank and Mushegh
# just says that capability "isn't configured yet" instead of crashing.
# ======================================================================================

# ---- Obsidian vault — REQUIRED (Mushegh's L3 memory; READS/SEARCHES the local mirror) --
# Keep this set: it's validated at startup and Mushegh warns loudly if it's missing/unreadable.
MUSHEGH_VAULT_PATH=C:\Users\iamva\Documents\Obsidian Vault
# Let Mushegh WRITE notes into the vault (write_vault tool). Keep FALSE on the laptop — there the
# vault is a one-way VPS->local sync target and local edits get clobbered. Set TRUE only on the
# host that OWNS the vault (the VPS), where writes are authoritative and safe.
MUSHEGH_VAULT_WRITABLE=false

# ---- Session hygiene: smart reset -----------------------------------------------------
# After this many idle minutes, the brain journals the prior conversation (L2) and clears WORKING
# memory, so a fresh conversation hours later doesn't drag stale context/anaphora. Durable memory
# (L1/L2/L3) is untouched. 0 disables.
MUSHEGH_SESSION_IDLE_RESET_MINUTES=180

# Speed vs polish (A/B). ON = a SHORT calendar/email/Notion-tasks/Telegram read is spoken verbatim,
# skipping the summary LLM pass (~1-3s faster on those turns). OFF (default) = the summary polishes a
# raw multi-item dump into a clean spoken sentence. Long results always summarise even when ON.
MUSHEGH_DIRECT_SPEAK_CHANNEL_READS=false

# ---- Phase 9: persistent memory (learned facts L1 + daily journal L2) ------------------
# Markdown under memory/learned and memory/journal — Mushegh remembers across restarts.
MUSHEGH_MEMORY_ENABLED=true
MUSHEGH_MEMORY_RECALL_LIMIT=5          # facts the recall tool returns
MUSHEGH_MEMORY_DIGEST_MAX=20           # recent learned facts injected into his system prompt
# The L4 cache is in-process and needs no service. The optional Redis/Valkey tier was REMOVED
# on 2026-09-20 (O3.2, Jev p=0.98, conf 0.96): it had never been enabled, and a second daemon
# on a host that has already OOMed is not earned by one use case. A restart-surviving cache,
# if ever wanted, belongs in Postgres.
# L5 semantic recall (Phase 9c): recall facts by meaning, not just keywords. Only active if a local
# embedder is installed — `uv sync` then `pip install sentence-transformers` (CPU model, ~90MB).
# Without it, recall stays keyword-only (graceful). No config needed beyond the toggle.
MUSHEGH_MEMORY_SEMANTIC_ENABLED=true

# ---- Phase 10: proactive engine (speak unprompted, clarify, confirm) -------------------
# OFF by default — he only volunteers things when you switch this on. A background tick weighs
# signals (routine, calendar, unread, self-health) and may speak/push within a daily budget and
# quiet hours. Modes (focus/lockdown) mute it on demand. See docs/EXPANSION-PLAN.md.
MUSHEGH_PROACTIVE_ENABLED=false
MUSHEGH_PROACTIVE_TICK_SECONDS=300
MUSHEGH_PROACTIVE_QUIET_HOURS=23:00-07:00     # no unprompted voice in this local-time window
# D-29 commits to THREE audio interruptions per day. This shipped 6, which contradicted the
# charter; the charter wins. python-dotenv strips the trailing comment below, as it does for
# every other commented line in this file.
MUSHEGH_PROACTIVE_DAILY_BUDGET=3              # max unprompted interjections per day (D-29: three, not six)
MUSHEGH_HOME_LOCATION=                        # default place for "weather" + the morning briefing

# ---- Web search (Tavily) --------------------------------------------------------------
MUSHEGH_TAVILY_API_KEY=                 # https://tavily.com -> API key

# ---- Page scrape (Jina Reader) --------------------------------------------------------
# Uses https://r.jina.ai — FREE + KEYLESS, nothing to configure. Optional key for higher limits:
MUSHEGH_JINA_API_KEY=                   # optional; get one free at https://jina.ai

# ---- Interactive headless browser (Browserbase; needs `uv sync --extra browse`) -------
MUSHEGH_BROWSERBASE_API_KEY=
MUSHEGH_BROWSERBASE_PROJECT_ID=

# ---- Telegram -------------------------------------------------------------------------
# Reading unread DMs needs a Telethon USER login (api id+hash from https://my.telegram.org,
# then a one-time interactive sign-in). Sending uses the bot token below.
# MUSHEGH_TELEGRAM_API_ID and MUSHEGH_TELEGRAM_API_HASH are commented, not blank: both are
# `... | None = None` and `env_ignore_empty` is False, so a blank raises ValidationError
# and a fresh machine cannot start. Commented = absent = the None default. Uncomment once
# you have an id + hash from my.telegram.org.
# MUSHEGH_TELEGRAM_API_ID=
MUSHEGH_TELEGRAM_API_HASH=
MUSHEGH_TELEGRAM_SESSION=mushegh
MUSHEGH_TELEGRAM_BOT_TOKEN=
MUSHEGH_TELEGRAM_DEFAULT_CHAT=          # default chat id for "send a telegram"
MUSHEGH_TELEGRAM_PHONE=                 # your number (+countrycode...) for the one-time login
MUSHEGH_GIPHY_API_KEY=                  # optional; "@gif <query>" search falls back to Giphy's public key
# Your personal music: a Telegram chat/group where you keep audio tracks. Mushegh finds a track
# and delivers it to your phone Telegram to tap & play. Use an id, @username, or the exact title.
MUSHEGH_TELEGRAM_PLAYLIST_CHAT=
MUSHEGH_TELEGRAM_MUSIC_TARGET=me        # where the chosen track is sent ('me' = Saved Messages → phone)

# ---- Music backend for "play X" -------------------------------------------------------
# ytmusic = YouTube Music (free, music-tuned, no account) |
# telegram = your personal Telegram playlist | youtube = plain YouTube search.
MUSHEGH_MUSIC_SOURCE=ytmusic

# ---- Phase 11: Gmail + Google Calendar (one OAuth app) --------------------------------
# To use Gmail "through an app": a real Google Cloud OAuth app. Do the one-time
# consent once (uv run python bench/google_login.py) — see that file's header for the console steps
# (enable Gmail API + Calendar API, create a Web OAuth client, add the redirect below) — then paste
# the printed refresh token here. The same app/token covers Gmail (read/draft/send) AND Calendar.
# send_email + create_event are confirm-gated. Everything degrades until these are set.
MUSHEGH_GOOGLE_CLIENT_ID=
MUSHEGH_GOOGLE_CLIENT_SECRET=
MUSHEGH_GOOGLE_REFRESH_TOKEN=
MUSHEGH_GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8585/oauth2callback   # must match the Google app

# Google Maps API key (Phase 11) -- for live travel times + place lookup (read-only).
# Enable Directions API + Places API at https://console.cloud.google.com/apis/library
MUSHEGH_GOOGLE_MAPS_API_KEY=
# Healthchecks.io for external monitoring (S23)
# Create a free check at https://healthchecks.io and copy the UUID
MUSHEGH_HEALTHCHECKS_UUID=
# ---- Phase 11: Home Assistant (local-first smart home) --------------------------------
# Create a long-lived access token in HA (your profile -> Security -> Long-lived access tokens) and
# point MUSHEGH_HA_URL at your instance. Mushegh reads states ("is the door locked?") and calls
# services (lights/scenes/climate/locks); locks/alarms/covers are confirmed first. Degrades if unset.
MUSHEGH_HA_URL=                        # e.g. http://homeassistant.local:8123
MUSHEGH_HA_TOKEN=

# ---- Phase 11: Notion (read / write / comment) ----------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations, copy its secret, then
# SHARE each page/database you want Mushegh to touch with that integration (••• → Connections →
# your integration). Notion is deny-by-default: he only ever sees what you share. Writes/comments
# are confirm-gated. Degrades until set.
MUSHEGH_NOTION_TOKEN=                  # 'ntn_...' or 'secret_...' integration token
MUSHEGH_NOTION_VERSION=2022-06-28
MUSHEGH_NOTION_TASKS_DB_ID=            # tasks dashboard DB id (32-hex from its URL); share it with the integration

# Autonomous daily BACKLOG pass (Phase 3.1) — opt-in. When on AND a tasks DB is set, a daily job has the
# bounded worker attempt overdue/undated Notion tasks (safe research/draft only; outward steps deferred)
# and comments the result onto each task. OFF by default (it acts unattended).
MUSHEGH_BACKLOG_ENABLED=false
MUSHEGH_BACKLOG_TIME=09:30            # HH:MM, your timezone
MUSHEGH_BACKLOG_MAX_TASKS=2          # tasks attempted per daily pass

# ---- The autonomy governor (36.F6) ---------------------------------------------------
# Each bounded worker run has its own step and wall-clock budget. These bound the RUNS: one shared
# rolling window across EVERY autonomous path (work_on_task, the backlog pass, objectives, the
# co-pilot, the code self-improve loop), enforced in code before a step executes, never by asking a
# model to behave. A refusal is deterministic and is written to the audit log.
# The ledger persists to <state_dir>/governor.json, because an in-memory counter is reset by exactly
# the restart loop it exists to stop - and this brain restarts daily by design.
# Leave these alone unless a real run meets one; they are generous for ordinary use and tight enough
# that a runaway stops within a window rather than within a billing cycle.
MUSHEGH_AUTONOMY_MAX_CALLS=200        # tool + model calls per window, across all autonomous runs
MUSHEGH_AUTONOMY_MAX_USD=2.0          # estimated spend per window (unpriced models counted, not free)
MUSHEGH_AUTONOMY_MAX_SECONDS=3600     # total autonomous wall-clock per window
MUSHEGH_AUTONOMY_WINDOW_HOURS=24      # the window; the ledger rolls over when it expires

# ---- External tools via MCP (Model Context Protocol) ----------------------------------
# Mushegh speaks MCP over stdio, so ANY MCP server's tools appear in his registry (namespaced
# mcp__<server>__<tool>). JSON map of name -> {command, args, env}; inline JSON or a path to a .json
# file. Only servers listed here are launched (no default, no arbitrary access); missing -> zero tools.
#
# Composio (250+ OAuth-managed app integrations — Slack, GitHub, Google Drive, Linear, …) is the
# recommended way to add breadth: in the Composio dashboard create an MCP server, connect your app
# accounts there, then paste its URL below (bridged to stdio via mcp-remote). Preferred over Composio's
# agent-SDK path — no new dependency, no parallel agent loop; the tools join Mushegh's own voice-tuned
# loop and his confirm-gate still applies to outward actions. Example (single line):
# MUSHEGH_MCP_SERVERS={"composio":{"command":"npx","args":["-y","mcp-remote","https://mcp.composio.dev/<your-server-id>"]}}
MUSHEGH_MCP_SERVERS=

# ---- System control (files / processes / PowerShell) ----------------------------------
MUSHEGH_SYSTEM_TOOLS_ENABLED=true
# Paths under these roots are refused for deletion (catastrophe guard).
MUSHEGH_SYSTEM_PROTECTED_PATHS=C:\Windows,C:\Program Files,C:\Program Files (x86)

# ---- Phase 13: coding & self-improvement (Git + GitHub) -------------------------------
# Mushegh can read/edit his own source, run the suite, lint, and make REVERSIBLE git commits (never
# force-push/reset — a revert is always a new commit). Secrets are hard-blocked from read/write.
# Commits + pushes are confirm-gated. To let him push: create a GitHub repo + a fine-grained PAT
# (Contents: read/write on that repo), then `git remote add origin https://<PAT>@github.com/<you>/<repo>.git`
# — see TODO-NOW.md Phase 13 for the exact steps. He commits locally (fully reversible) even with no remote.
MUSHEGH_CODING_TOOLS_ENABLED=true
MUSHEGH_SKILLS_ENABLED=true
MUSHEGH_GIT_AUTHOR_NAME=Mushegh
MUSHEGH_GIT_AUTHOR_EMAIL=mushegh@vazghen.local
# One-step "open a GitHub issue" (create_github_issue tool) — a fine-grained PAT with Issues:
# read/write on the repo below. Lets Mushegh file an issue in a single tool call instead of the 2-step
# Composio router. Blank = the tool says it's not configured. (The PAT above under Phase 13 self-
# improvement is for PUSH; this one only needs Issues scope — you can reuse the same PAT if it has both.)
MUSHEGH_GITHUB_TOKEN=
MUSHEGH_GITHUB_REPO=                    # e.g. you/your-repo

# ---- Production: arm the OpenClaw fleet consult (off by default) -----------------------
# The fleet touches shared VPS infra, so Mushegh only CONSULTS it (via ispir) when armed. Leave false
# for testing; set true for a 24/7 deployment where you want him to reach the team without asking.
MUSHEGH_FLEET_AUTHORIZED=false

# ---- Local visible browser (needs: uv sync --extra browse ; playwright install chromium)
MUSHEGH_BROWSER_TOOLS_ENABLED=true
MUSHEGH_BROWSER_HEADLESS=false                  # false = you can watch + finish logins
MUSHEGH_BROWSER_PROFILE_DIR=                    # blank = <repo>/.mushegh-browser (stays logged in)

# ---- Protocols (password-gated routines — CHANGE THESE) -------------------------------
MUSHEGH_PROTOCOLS_ENABLED=true
# All protocol passwords are 4 random digits — generate via 'scripts/rotate_protocols.sh' or
# the setup wizard ("regenerate protocol passwords") after first deploy. Each password is a
# separate 0000-9999 value; the runner uses constant-time compare.
MUSHEGH_PROTOCOL_GOODNIGHT_PASSWORD=0000        # 'goodnight'  -> stops Mushegh
MUSHEGH_PROTOCOL_PHOENIX_PASSWORD=0000          # 'phoenix'    -> restarts Mushegh
MUSHEGH_PROTOCOL_RAGNAROK_PASSWORD=0000        # 'ragnarok'   -> restarts the laptop
MUSHEGH_PROTOCOL_BACKUP_PASSWORD=0000          # 'backup'     -> archives Mushegh memory
MUSHEGH_PROTOCOL_PING_PASSWORD=0000            # 'ping'       -> sends a phone push test
MUSHEGH_PROTOCOL_DIAGNOSTICS_PASSWORD=0000      # 'diagnostics' -> writes a local health report
MUSHEGH_PROTOCOL_AUDITPACK_PASSWORD=0000       # 'auditpack'  -> archives audit logs
MUSHEGH_PROTOCOL_CHECKPOINT_PASSWORD=0000       # 'checkpoint' -> archives non-secret context

# ---- Phase 4: proactivity & push ------------------------------------------------------
MUSHEGH_SCHEDULER_DB_PATH=                       # blank = <repo>/mushegh_jobs.sqlite
MUSHEGH_NTFY_TOPIC=                              # ntfy.sh topic for phone push (pick a unique one)
MUSHEGH_NTFY_SERVER=https://ntfy.sh
# Phase 4b true-24/7: one-shot/at reminders push even with the PC off (ntfy holds them server-side).
# Recurring (daily) reminders need the always-on VPS ticker — see deploy/vps/. Once deployed, set:
MUSHEGH_TICKER_URL=                              # e.g. http://127.0.0.1:8770 (reach VPS via tunnel)
MUSHEGH_TICKER_TOKEN=                            # optional bearer secret, must match the ticker

# ---- Phase 5: speaker biometrics (respond only to the enrolled owner's voice) ---------
MUSHEGH_SPEAKER_ID_ENABLED=false                 # true after enrolling (uv sync --extra identity; bench/enroll_voice.py)
MUSHEGH_SPEAKER_PROFILE_PATH=                    # blank = <repo>/voiceprint.json
MUSHEGH_SPEAKER_THRESHOLD=0.25                   # ECAPA cosine accept threshold (raise = stricter)

# ---- Phase 6: multi-device routing ----------------------------------------------------
# Auto-route output to AirPods/headphones when connected to this laptop (barge-in then auto-on).
MUSHEGH_AUTO_ROUTE_HEADPHONES=true
# Remote clients (iPhone/Mentra) declare their device via the Hello frame; locally MUSHEGH_DEVICE_HINT
# (above) can force a kind. Set MUSHEGH_AUDIO_OUTPUT_DEVICE=auto to always prefer headphones.

# ---- 04.R4: the shell's blast radius ---------------------------------------------------
# The one directory `run_powershell` works in. Empty = <state_dir>/shell (i.e. ~/.mushegh/shell).
# This is the bound that actually holds: the process runs WITH THIS AS ITS CWD. The command
# scan beside it is a tripwire for the ordinary mistake, not a sandbox.
# MUSHEGH_SHELL_WORKDIR=
# Let shell commands reach the network. Off by default; a download or an ssh is refused by name.
# MUSHEGH_SHELL_ALLOW_NETWORK=false

# ---- 44.R4: escalate on low confidence ------------------------------------------------
# When the model hedges about a WRITE that is not in the confirm tier, ask instead of proceeding.
# MUSHEGH_ESCALATE_ON_LOW_CONFIDENCE=true

# ---- Postgres -----------------------------------------------------------------------
# There is no MUSHEGH_POSTGRES_DSN, and there is no setting that selects a backend.
# The staged S30 adapters were removed on 2026-10-04 (D-02, M02). SQLite in WAL mode, reached
# through one module, is the store — see docs/DECISIONS.md D-02 for why the migration was
# a mistake rather than unfinished work.

# ---- S36: secrets that are not in the repo (D-95) ---------------------------------------
# Resolved by mushegh/shared/secrets.py in this order: ENVIRONMENT WINS, then Infisical, then an
# age-encrypted file. Hydration cannot abort the boot (PRINCIPLES.md 1: a brain that will not
# start cannot be diagnosed).
#
# Infisical is NOT run locally on purpose. ARCHITECTURE.md says this system has "no secrets
# manager and no second database"; self-hosting Infisical means a server plus Postgres, which is
# the exact addition that line forbids. Point these at a remote workspace (Cloud or your own
# on-prem host) and nothing is vendored.
#
# All four are commented out on purpose: a BLANK value raises ValidationError under
# env_ignore_empty=False, which is what broke a fresh install on 2026-10-04.
# Leave all four unset and Mushegh reads its secrets from the environment / .env as before.
#
# A service token from Infisical (not a login session), scoped to ONE workspace.
# MUSHEGH_INFISICAL_TOKEN=
# MUSHEGH_INFISICAL_WORKSPACE_ID=
# MUSHEGH_INFISICAL_PROJECT_ID=
# Which environment inside that project. "dev" matches Infisical's own default.
# MUSHEGH_INFISICAL_ENV=dev
# Override only for self-hosted / on-prem Infisical.
# MUSHEGH_INFISICAL_API=https://secrets.infisical.com/api/v3
# Seconds before a secrets call is abandoned in favour of the local floor. Keep it short: a
# boot must not hang on a secrets backend.
# MUSHEGH_INFISICAL_TIMEOUT=5.0
#
# The offline floor: a JSON object of name -> value that you decrypted yourself with age. This
# module never invokes age and never holds a key; it only reads the plaintext result if present.
# MUSHEGH_AGE_SECRETS=

# --- A2A: the nine OpenClaw agents of the fleet (one bearer token per peer = per agent) ---
# The gateway publishes its card at <base>/.well-known/agent-card.json and takes JSON-RPC at
# <base>/a2a/v1. The token IS the peer identity: the gateway maps peer `<prefix>.<agent>` to
# that agent through its own `bindings`, so these address a specialist rather than unlock all.
MUSHEGH_A2A_BASE_URL=                        # e.g. https://<your-gateway-host>
MUSHEGH_A2A_TOKENS=                          # {"agent": "token", ...}
MUSHEGH_A2A_PEER_PREFIX=jarvis               # must match the keys in channels.a2a.peers
# --- the nine Hermes profiles: no A2A server, so its one-shot CLI over the same SSH target ---
MUSHEGH_HERMES_CLI_PATH=                     # the PINNED launcher in the checkout, not PATH's `hermes`
MUSHEGH_HERMES_PROFILES_ROOT=                # e.g. /home/<user>/.hermes/profiles
MUSHEGH_HERMES_REQUEST_TIMEOUT_SECONDS=300
RUBO_REPO=                                   # the Ruben (finance) checkout
